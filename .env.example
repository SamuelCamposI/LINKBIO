# ============================================================
# Variables de entorno — Login / Auth (preparado para MongoDB)
# ============================================================
# Cómo se usa ahora (modo mock):
# 1) VITE_AUTH_MODE=mock
# 2) Entras con VITE_DEMO_EMAIL + VITE_DEMO_PASSWORD
# 3) Si funciona, ves el dashboard
#
# Cuando tengas backend + MongoDB Atlas:
# 1) Cambia VITE_AUTH_MODE=api
# 2) Pon la URL de tu API en VITE_API_URL
# 3) MONGODB_URI solo en el SERVIDOR (sin VITE_), nunca en el frontend
# ============================================================

# mock = login de prueba local | api = backend real
VITE_AUTH_MODE=mock

# URL del API (solo cuando VITE_AUTH_MODE=api)
VITE_API_URL=http://localhost:3000

# Usuario de prueba mientras no haya base de datos
VITE_DEMO_EMAIL=samuel@gmail.com
VITE_DEMO_PASSWORD=1234

# ---- Solo backend (NO copiar al frontend) ----
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=linkbio
